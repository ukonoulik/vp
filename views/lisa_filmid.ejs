<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Filmi lisamine</title>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
    <h1>Eesti film</h1>
    <p><a href="/eestifilm">Eesti filmi avalehele</a></p>
    <h2>Lisa film</h2>
    <form method="POST" action="/eestifilm/lisa_filmid">
        <label for="titleInput">Filmi pealkiri</label>
        <input id="titleInput" name="titleInput" type="text" value="<%= titleInput ?? '' %>">
        <br>
        <label for="yearInput">Väljalaskeaasta</label>
        <input id="yearInput" name="yearInput" type="number" min="1888" max="2100" value="<%= yearInput ?? '' %>">
        <br>
        <input type="submit" value="Salvesta">
    </form>
    <p><%= notice %></p>
</body>
</html>
