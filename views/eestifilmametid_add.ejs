<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Filmiameti lisamine</title>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
    <h1>Eesti film</h1>
    <p><a href="/eestifilm">Eesti filmi avalehele</a></p>
    <h2>Lisa filmiamet</h2>
    <form method="POST" action="/eestifilm/lisa_ametid">
        <label for="title">Ameti nimetus</label>
        <input id="title" name="title" type="text" value="<%= title || '' %>" required>
        <br>
        <label for="description">Ameti kirjeldus</label>
        <input id="description" name="description" type="text" value="<%= description || '' %>" required>
        <br>
        <button type="submit">Salvesta</button>
    </form>
    <p><%= notice %></p>
</body>
</html>
