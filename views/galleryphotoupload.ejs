<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Foto üleslaadimine</title>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
    <p>Siin saab galeriisse fotosid laadida.</p>
    <ul>
        <li><a href="/">Avalehele</a></li>
    </ul>
    <hr>
    <h2>Lae foto üles</h2>
    <form method="POST" enctype="multipart/form-data">
		<label for="photoInput">Vali pildifail (.jpg)</label>
		<input id="photoInput" name="photoInput" type="file">
		<br>
		<label for="altInput">Sisesta alternatiivtekst (alt)</label>
		<input id="altInput" name="altInput" type="text" placeholder="Sellel fotol on...">
		<br>
		<input id="privacyInput1" name="privacyInput" type="radio" value="1" checked>
		<label for="privacyInput1">Privaatne, ainult sina näed</label>
		<br>
		<input id="privacyInput2" name="privacyInput" type="radio" value="2">
		<label for="privacyInput2">Sisseloginud kasutajatele</label>
		<br>
		<input id="privacyInput3" name="privacyInput" type="radio" value="3">
		<label for="privacyInput3">Avalik (kõik näevad)</label>
		<br>
		<input id="photoSubmit" name="photoSubmit" type="submit" value="Lae üles">
    </form>
</body>
</html>
