<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Fotogalerii</title>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
    <h1>Fotogalerii</h1>
    <p><a href="/">Avalehele</a> | <a href="/galleryphotoupload">Lae foto üles</a></p>
    <p>Siin on fotod privaatsustasemega 2 või 3.</p>

    <% if (photos.length === 0) { %>
        <p>Galeriis veel fotosid ei ole.</p>
    <% } %>

    <% photos.forEach(photo => { %>
        <a href="/gallery/normal/<%= photo.filename %>">
            <img src="/gallery/thumbs/<%= photo.filename %>" alt="<%= photo.alttext || 'Galerii foto' %>" width="100" height="100">
        </a>
    <% }); %>
</body>
</html>
