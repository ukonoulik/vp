<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Filmiinimese lisamine</title>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
    <h1>Eesti film</h1>
    <p>Siin saab lisada Eesti filmidega seotud inimesi.</p>
    <ul>
        <li><a href="/">Avalehele</a></li>
        <li><a href="/eestifilm">Eesti filmi avalehele</a></li>
    </ul>
    <hr>
    <h2>Lisa filmiinimene</h2>
    <form method="POST" action="/eestifilm/lisa_film_inimesed">
        <label for="firstNameInput">Eesnimi</label>
        <input id="firstNameInput" name="firstNameInput" type="text" value="<%= firstNameInput || '' %>" required>
        <br>
        <label for="lastNameInput">Perekonnanimi</label>
        <input id="lastNameInput" name="lastNameInput" type="text" value="<%= lastNameInput || '' %>" required>
        <br>
        <label for="bornInput">Sünnikuupäev</label>
        <input id="bornInput" name="bornInput" type="date" value="<%= bornInput || '' %>" required>
        <br>
        <label for="deceasedInput">Surmakuupäev</label>
        <input id="deceasedInput" name="deceasedInput" type="date" value="<%= deceasedInput || '' %>">
        <br>
        <button type="submit">Salvesta</button>
    </form>
    <p><%= notice %></p>
</body>
</html>
